# Copy to `.env.local` and fill in values. Never commit real secrets.

# --- Contact form (Resend) ---
# https://resend.com — verify your sending domain, then set a from-address on it.
RESEND_API_KEY=
# Defaults to admin@pfdomesticsolutions.com if unset
CONTACT_TO_EMAIL=admin@pfdomesticsolutions.com
# Must be a verified Resend sender, e.g. "P&F Domestic Solutions <enquiries@pfdomesticsolutions.com>"
CONTACT_FROM_EMAIL=P&F Domestic Solutions <onboarding@resend.dev>
# Set to 1 to log enquiries without sending email (local testing)
CONTACT_FORM_DRY_RUN=1

# --- Optional: Cloudflare Turnstile CAPTCHA ---
# https://dash.cloudflare.com → Turnstile
# Leave blank to skip CAPTCHA (honeypot + rate limit + timing checks still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: analytics (gated by cookie consent → analytics category) ---
# Scripts only load after the visitor accepts analytics cookies.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
